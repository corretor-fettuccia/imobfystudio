{
  "schemaVersion": 3,
  "id": "professional-branding-pro",
  "name": "Professional Branding Pro",
  "version": "1.2.0",
  "type": "section",
  "category": "Branding",
  "icon": "◆",
  "description": "Seção premium de posicionamento profissional integrada ao perfil visual global do projeto, com manifesto, identidade e enquadramento responsivo.",
  "entry": {
    "template": "template.html",
    "style": "plugin.css",
    "script": "plugin.js"
  },
  "defaults": {
    "useProjectProfile": true,
    "kicker": "POSICIONAMENTO PROFISSIONAL",
    "introWord": "Eu",
    "headline": "Não vendo imóveis",
    "headlineAccent": "Estruturo decisões.",
    "identityLine": "ROBERTO FETTUCCIA · CRECI 83599-F",
    "specialty": "Aquisição estruturada · Terreno + Construção · Crédito Imobiliário",
    "showSpecialty": true,
    "typewriterEnabled": true,
    "typingSpeed": 58,
    "quote1Enabled": true,
    "quote1": "Grandes patrimônios são construídos com estratégia, não apenas com recursos.\n\nSegurança para construir. Clareza para decidir.",
    "quote1Author": "ROBERTO FETTUCCIA — Aquisição estruturada.",
    "quote2Enabled": true,
    "quote2": "Transformando terreno, planejamento e construção em patrimônio de valor.",
    "quote2Author": "ROBERTO FETTUCCIA — Construção financiada.",
    "quote3Enabled": true,
    "quote3": "Quem domina as regras do jogo transforma conhecimento em vantagem e riscos em decisões calculadas.\n\nConhecer as regras é importante. Dominar suas consequências é o que gera vantagem.",
    "quote3Author": "ROBERTO FETTUCCIA — O melhor consultor é burocrata.",
    "quote4Enabled": true,
    "quote4": "Quem conhece o processo em profundidade toma decisões que os outros nem enxergam.",
    "quote4Author": "ROBERTO FETTUCCIA — Excelência é atenção aos detalhes.",
    "ctaEnabled": true,
    "ctaText": "Conheça meu perfil",
    "ctaUrl": "/perfil-profissional",
    "ctaNewTab": false,
    "navigationLabel": "NAVEGAR",
    "showTopNavigation": true,
    "showBottomNavigation": true,
    "showDots": true,
    "autoplay": true,
    "autoplayMs": 5200,
    "pauseOnHover": true,
    "transitionMs": 650,
    "transitionEffect": "wipe",
    "backgroundImage": "assets/images/corporate.webp",
    "backgroundPositionX": 50,
    "backgroundPositionY": 50,
    "backgroundColor": "#090a0b",
    "overlayColor": "#08090a",
    "overlayOpacity": 68,
    "accentColor": "#ccb78b",
    "headingColor": "#ffffff",
    "textColor": "#f3f1ec",
    "mutedColor": "#a7a7a7",
    "cardColor": "#121315",
    "cardOpacity": 78,
    "cardBorderOpacity": 34,
    "cardBlur": 12,
    "cardRadius": 26,
    "contentWidth": 1400,
    "sectionMinHeight": 680,
    "paddingTop": 96,
    "paddingBottom": 112,
    "columnGap": 72,
    "headlineSize": 66,
    "quoteSize": 24,
    "layout": "quotes-left",
    "grain": true,
    "revealOnScroll": true,
    "revealDistance": 28,
    "backgroundFit": "cover",
    "backgroundZoom": 100,
    "backgroundMobilePositionX": 50,
    "backgroundMobilePositionY": 50,
    "backgroundMobileZoom": 100
  },
