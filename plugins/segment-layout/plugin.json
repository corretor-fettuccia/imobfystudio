{
  "schemaVersion": 3,
  "id": "segment-layout",
  "name": "Segmento",
  "version": "1.1.0",
  "type": "section",
  "category": "Composição",
  "icon": "▥",
  "description": "Área estrutural com 1 a 5 colunas ou linhas, alinhamento interno e suporte a Segmentos aninhados.",
  "composition": {
    "role": "both"
  },
  "layout": {
    "mode": "segment-slots",
    "slot": "<!--IMOBIFY_SEGMENT_SLOTS-->",
    "maxChildren": 25,
    "maxTracks": 5,
    "acceptRoles": [
      "item",
      "both"
    ]
  },
  "entry": {
    "template": "template.html",
    "style": "plugin.css",
    "script": "plugin.js"
  },
  "defaults": {
    "itemCount": 0,
    "direction": "columns",
    "tracks": 2,
    "gap": 24,
    "itemGap": 16,
    "padding": 32,
    "minHeight": 0,
    "widthMode": "container",
    "verticalAlign": "stretch",
    "horizontalAlign": "stretch",
    "mobileMode": "stack",
    "backgroundEnabled": false,
    "backgroundColor": "#f5f7f8",
    "backgroundImage": "",
    "overlayOpacity": 0,
    "title": "",
    "subtitle": ""
  },
  "fields": [
    {
      "key": "direction",
      "label": "Dividir o segmento em",
      "type": "select",
      "options": [
        {
          "label": "Colunas",
          "value": "columns"
        },
        {
          "label": "Linhas",
          "value": "rows"
        }
      ],
      "group": "Arranjo"
    },
    {
      "key": "tracks",
      "label": "Quantidade de divisões",
      "type": "range",
      "min": 1,
      "max": 5,
      "step": 1,
      "group": "Arranjo",
      "note": "Cada divisão funciona como uma célula. Uma célula pode receber mais de um componente."
    },
    {
      "key": "gap",
      "label": "Espaço entre células (px)",
      "type": "range",
      "min": 0,
      "max": 96,
      "step": 2,
      "group": "Arranjo"
    },
    {
      "key": "itemGap",
      "label": "Espaço entre itens da célula (px)",
      "type": "range",
      "min": 0,
      "max": 80,
      "step": 2,
      "group": "Arranjo"
    },
    {
      "key": "widthMode",
      "label": "Largura",
      "type": "select",
      "options": [
        {
          "label": "Container do projeto",
          "value": "container"
        },
        {
          "label": "Largura total",
          "value": "full"
        }
      ],
      "group": "Segmento"
    },
    {
      "key": "padding",
      "label": "Respiro interno (px)",
      "type": "range",
      "min": 0,
      "max": 120,
      "step": 2,
      "group": "Segmento"
    },
    {
      "key": "minHeight",
      "label": "Altura mínima (px; 0 = automática)",
      "type": "range",
      "min": 0,
      "max": 1200,
      "step": 20,
      "group": "Segmento"
    },
    {
      "key": "verticalAlign",
      "label": "Alinhamento vertical do conteúdo",
      "type": "select",
      "options": [
        {
          "label": "Esticar",
          "value": "stretch"
        },
        {
          "label": "Topo",
          "value": "start"
        },
        {
          "label": "Meio",
          "value": "center"
        },
        {
          "label": "Base",
          "value": "end"
        }
      ],
      "group": "Segmento",
      "note": "Posiciona os componentes verticalmente dentro de cada célula do Segmento."
    },
    {
      "key": "horizontalAlign",
      "label": "Alinhamento horizontal do conteúdo",
      "type": "select",
      "options": [
        {
          "label": "Esticar",
          "value": "stretch"
        },
        {
          "label": "Esquerda",
          "value": "start"
        },
        {
          "label": "Centro",
          "value": "center"
        },
        {
          "label": "Direita",
          "value": "end"
        },
        {
          "label": "Linha de base",
          "value": "baseline"
        }
      ],
      "group": "Segmento",
      "note": "Controla a posição lateral do conteúdo. Linha de base é útil para alinhar elementos tipográficos."
    },
    {
      "key": "mobileMode",
      "label": "Comportamento no celular",
      "type": "select",
      "options": [
        {
          "label": "Empilhar as colunas",
          "value": "stack"
        },
        {
          "label": "Manter o arranjo",
          "value": "keep"
        }
      ],
      "group": "Responsivo"
    },
    {
      "key": "backgroundEnabled",
      "label": "Usar fundo no segmento",
      "type": "toggle",
      "group": "Fundo"
    },
    {
      "key": "backgroundColor",
      "label": "Cor de fundo",
      "type": "color",
      "group": "Fundo"
    },
    {
      "key": "backgroundImage",
      "label": "Imagem de fundo",
      "type": "image",
      "group": "Fundo"
    },
    {
      "key": "overlayOpacity",
      "label": "Overlay da imagem (%)",
      "type": "range",
      "min": 0,
      "max": 90,
      "step": 5,
      "group": "Fundo"
    },
    {
      "key": "title",
      "label": "Título opcional",
      "type": "text",
      "group": "Cabeçalho"
    },
    {
      "key": "subtitle",
      "label": "Texto opcional",
      "type": "textarea",
      "group": "Cabeçalho"
    }
  ]
}
