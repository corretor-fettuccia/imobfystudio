{
  "schemaVersion": 3,
  "id": "ar-card-popout-3d-stage",
  "name": "AR Card Popout 3D Stage",
  "version": "1.0.0",
  "type": "section",
  "category": "Interação",
  "icon": "▱",
  "description": "Section ampla com um cartão 3D que pulsa; ao abrir, o cartão deita, a casa é projetada em 3D e a frase principal e três blocos de texto saem do cartão. Sem botão, escalável do celular ao desktop.",
  "composition": {
    "role": "both",
    "cardinality": "single"
  },
  "origin": "Evolução do AR Card Popout 3D Single 1.2.0 (V9). Plugin independente: o original continua disponível.",
  "entry": {
    "template": "template.html",
    "style": "plugin.css",
    "script": "plugin.js"
  },
  "defaults": {
    "cardImage": "assets/card-normal.png",
    "cardImageAlt": "Terreno do empreendimento",
    "kicker": "SEU TERRENO",
    "title": "Toque e veja\no futuro",
    "subtitle": "Projeção 3D do que vai ser construído aqui.",
    "textColor": "#ffffff",
    "cardAriaLabel": "Ver a projeção 3D da casa",
    "useProjectTypography": true,
    "projectionImage": "assets/popout.png",
    "projectionImageAlt": "Projeção 3D da casa",
    "projectionWidth": 122,
    "projectionLift": 10,
    "projectionDepth": 28,
    "headline": "É assim que vai ficar sua nova casa",
    "headlineUseProjectColor": true,
    "headlineColor": "#111827",
    "block1Label": "Planta inteligente",
    "block1Text": "3 dormitórios com suíte e luz natural o dia todo.",
    "block2Label": "Espaço para viver",
    "block2Text": "Varanda integrada à sala e quintal para a família.",
    "block3Label": "Pronto para morar",
    "block3Text": "Acabamento completo, entregue com escritura.",
    "blocksLayout": "orbit",
    "blockStyle": "glass-light",
    "blockConnectors": true,
    "blockDepth": 60,
    "accentMode": "project",
    "accentColor": "#2c66ff",
    "stageHeight": 88,
    "cardFill": 66,
    "mobileCardWidth": 76,
    "cardRatio": "0.6667",
    "radiusMode": "original",
    "cardRadius": 22,
    "perspective": 2.2,
    "openTilt": 68,
    "openDrop": 15,
    "pointerTilt": true,
    "floatProjection": true,
    "openTrigger": "both",
    "autoOpenDelay": 350,
    "replayOnScroll": true,
    "pulseMode": "waves",
    "pulseStrength": "medium",
    "showHint": true,
    "hintText": "Toque no cartão",
    "openByDefault": false,
    "projectionShadows": true,
    "projectionShadowColor": "#000000",
    "projectionShadowOpacity": 28,
    "castShadowOpacity": 90,
    "contactShadowOpacity": 76
  },
