  "entry": {
    "template": "template.html",
    "style": "plugin.css",
    "script": "plugin.js"
  },
  "defaults": {
    "eyebrow": "SIMULAÇÃO INICIAL",
    "title": "Veja uma estimativa antes de falar com o especialista.",
    "description": "Ajuste os valores abaixo para visualizar uma estimativa matemática de financiamento.",
    "propertyValue": 500000,
    "downPayment": 100000,
    "annualRate": 10.5,
    "years": 30,
    "monthlyIncome": 12000,
    "whatsapp": "5551998111078",
