  "fields": [
    {
      "key": "eyebrow",
      "label": "Chamada superior",
      "type": "text",
      "group": "Conteúdo"
    },
    {
      "key": "title",
      "label": "Título",
      "type": "text",
      "group": "Conteúdo"
    },
    {
      "key": "description",
      "label": "Descrição",
      "type": "textarea",
      "group": "Conteúdo"
    },
    {
      "key": "propertyValue",
      "label": "Valor padrão do imóvel",
      "type": "number",
      "min": 10000,
      "max": 10000000,
      "step": 1000,
      "group": "Valores iniciais"
    },
    {
      "key": "downPayment",
      "label": "Entrada padrão",
      "type": "number",
      "min": 0,
      "max": 5000000,
      "step": 1000,
      "group": "Valores iniciais"
    },
    {
      "key": "annualRate",
      "label": "Taxa anual estimada (%)",
      "type": "number",
      "min": 0,
      "max": 30,
      "step": 0.1,
      "group": "Valores iniciais"
    },
    {
      "key": "years",
      "label": "Prazo padrão (anos)",
      "type": "number",
      "min": 1,
      "max": 35,
      "step": 1,
      "group": "Valores iniciais"
    },
    {
      "key": "monthlyIncome",
      "label": "Renda mensal padrão",
      "type": "number",
      "min": 0,
      "max": 1000000,
      "step": 500,
      "group": "Valores iniciais"
    },
    {
      "key": "whatsapp",
      "label": "WhatsApp com DDI/DDD",
      "type": "text",
      "group": "CTA"
    },
    {
      "key": "ctaText",
      "label": "Texto do CTA",
      "type": "text",
      "group": "CTA"
    },
    {
      "key": "disclaimer",
      "label": "Aviso da simulação",
      "type": "textarea",
      "group": "Aviso"
    }
  ]
