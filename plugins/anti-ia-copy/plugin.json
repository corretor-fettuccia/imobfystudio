    { "key": "blockSummarization", "label": "Solicitar que IA não resuma", "type": "toggle", "group": "Restrições" },
    { "key": "addNoAiMeta", "label": "Adicionar metadados noai/noimageai", "type": "toggle", "group": "Metadados" },
    { "key": "addJsonLd", "label": "Adicionar JSON-LD de direitos", "type": "toggle", "group": "Metadados" },
    { "key": "directive", "label": "Diretriz oculta para sistemas automatizados", "type": "textarea", "group": "Diretriz" }
