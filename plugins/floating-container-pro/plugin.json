{
  "schemaVersion": 3,
  "id": "floating-container-pro",
  "name": "Floating Container Pro",
  "version": "1.3.0",
  "type": "section",
  "category": "Layout / Interação",
  "icon": "▣",
  "description": "Container flutuante reutilizável com portal real no BODY. Uso principal: cole somente #ID no HREF de qualquer botão. Inspetor autodeclarado, responsivo e compatível com modal, drawer, sheet e popover.",
  "instanceIdField": "panelId",
  "instanceIdPrefix": "floating-box",
  "layout": {
    "mode": "next-sections",
    "slot": "<!--IMOBIFY_LAYOUT_CHILDREN-->",
    "maxChildren": 12,
    "excludeTypes": [
      "footer"
    ]
  },
  "entry": {
    "template": "template.html",
    "style": "plugin.css",
    "script": "plugin.js"
  },
  "defaults": {
    "panelId": "",
    "itemCount": 0,
    "displayMode": "modal",
    "mobileMode": "bottom-sheet",
    "columns": 2,
    "tabletColumns": 2,
    "mobileColumns": 1,
    "gap": 20,
    "padding": 28,
    "width": 900,
    "maxHeight": 88,
    "borderRadius": 24,
    "backgroundColor": "#ffffff",
    "textColor": "#15181c",
    "borderColor": "#dfe4e8",
    "borderWidth": 1,
    "overlayEnabled": true,
    "overlayColor": "#000000",
    "overlayOpacity": 58,
    "shadow": "cinematic",
    "animation": "scale-fade",
    "animationSpeed": 240,
    "showHeader": false,
    "title": "",
    "subtitle": "",
    "closeEnabled": true,
    "closeIcon": "fa-solid fa-xmark",
    "closeText": "Fechar",
    "closePosition": "right",
    "closeSize": 42,
    "closeBackground": "#15181c",
    "closeColor": "#ffffff",
    "closeOnBackdrop": true,
    "closeOnEscape": true,
    "lockScroll": true,
    "openOnHash": true,
    "childMode": "compact"
  },
  "fields": [
    {
      "key": "panelId",
      "label": "ID de chamada do container",
      "type": "text",
      "group": "Chamada",
      "note": "ID público desta caixa. O campo HREF abaixo é gerado automaticamente."
    },
    {
      "key": "hrefTarget",
      "label": "HREF para abrir este container",
      "type": "computed",
      "template": "#{{panelId}}",
      "copy": true,
      "note": "Cole exatamente este valor no campo HREF / destino de qualquer botão do projeto. Nenhum JavaScript é necessário.",
      "group": "Chamada"
    },
    {
      "key": "itemCount",
      "label": "Quantidade de itens internos",
      "type": "range",
      "min": 0,
      "max": 12,
      "step": 1,
      "group": "Conteúdo interno",
      "note": "Itens internos são as seções posicionadas dentro deste container na Estrutura. O rodapé nunca é capturado."
    },
    {
      "key": "displayMode",
      "label": "Modo no desktop",
      "type": "select",
      "options": [
        {
          "label": "Caixa central",
          "value": "modal"
        },
        {
          "label": "Painel pela direita",
          "value": "drawer-right"
        },
        {
          "label": "Painel pela esquerda",
          "value": "drawer-left"
        },
        {
          "label": "Bottom sheet",
          "value": "bottom-sheet"
        },
        {
          "label": "Próximo ao botão (popover)",
          "value": "popover"
        }
      ],
      "group": "Posição"
    },
    {
      "key": "mobileMode",
      "label": "Modo no mobile",
      "type": "select",
      "options": [
        {
          "label": "Bottom sheet",
          "value": "bottom-sheet"
        },
        {
          "label": "Tela quase inteira",
          "value": "fullscreen"
        },
        {
          "label": "Caixa central",
          "value": "modal"
        },
        {
          "label": "Manter modo desktop",
          "value": "inherit"
        }
      ],
      "group": "Posição"
    },
    {
      "key": "columns",
      "label": "Colunas no desktop",
      "type": "range",
      "min": 1,
      "max": 4,
      "step": 1,
      "group": "Conteúdo interno"
    },
    {
      "key": "tabletColumns",
      "label": "Colunas no tablet",
      "type": "range",
      "min": 1,
      "max": 3,
      "step": 1,
      "group": "Conteúdo interno"
    },
    {
      "key": "mobileColumns",
      "label": "Colunas no mobile",
      "type": "range",
      "min": 1,
      "max": 2,
      "step": 1,
      "group": "Conteúdo interno"
    },
    {
      "key": "gap",
      "label": "Espaço entre itens (px)",
      "type": "range",
      "min": 0,
      "max": 80,
      "step": 2,
      "group": "Conteúdo interno"
    },
    {
      "key": "childMode",
      "label": "Espaçamento dos plugins internos",
      "type": "select",
      "options": [
        {
          "label": "Compactar para composição",
          "value": "compact"
        },
        {
          "label": "Manter espaçamento original",
          "value": "original"
        }
      ],
      "group": "Conteúdo interno"
    },
    {
      "key": "padding",
      "label": "Padding interno (px)",
      "type": "range",
      "min": 0,
      "max": 80,
      "step": 2,
      "group": "Caixa"
    },
    {
      "key": "width",
      "label": "Largura máxima desktop (px)",
      "type": "range",
      "min": 280,
      "max": 1400,
      "step": 20,
      "group": "Caixa"
    },
    {
      "key": "maxHeight",
      "label": "Altura máxima da viewport (%)",
      "type": "range",
      "min": 40,
      "max": 100,
      "step": 1,
      "group": "Caixa"
    },
    {
      "key": "borderRadius",
      "label": "Arredondamento (px)",
      "type": "range",
      "min": 0,
      "max": 48,
      "step": 2,
      "group": "Caixa"
    },
    {
      "key": "backgroundColor",
      "label": "Cor de fundo",
      "type": "color",
      "group": "Caixa"
    },
    {
      "key": "textColor",
      "label": "Cor do texto",
      "type": "color",
      "group": "Caixa"
    },
    {
      "key": "borderColor",
      "label": "Cor da borda",
      "type": "color",
      "group": "Caixa"
    },
    {
      "key": "borderWidth",
      "label": "Espessura da borda (px)",
      "type": "range",
      "min": 0,
      "max": 6,
      "step": 1,
      "group": "Caixa"
    },
    {
      "key": "shadow",
      "label": "Sombra",
      "type": "select",
      "options": [
        {
          "label": "Sem sombra",
          "value": "none"
        },
        {
          "label": "Suave",
          "value": "soft"
        },
        {
          "label": "Profunda",
          "value": "deep"
        },
        {
          "label": "Cinematográfica",
          "value": "cinematic"
        }
      ],
      "group": "Caixa"
    },
    {
      "key": "overlayEnabled",
      "label": "Usar fundo escurecido",
      "type": "toggle",
      "group": "Fundo / overlay"
    },
    {
      "key": "overlayColor",
      "label": "Cor do overlay",
      "type": "color",
      "group": "Fundo / overlay"
    },
    {
      "key": "overlayOpacity",
      "label": "Opacidade do overlay (%)",
      "type": "range",
      "min": 0,
      "max": 90,
      "step": 2,
      "group": "Fundo / overlay"
    },
    {
      "key": "animation",
      "label": "Animação de abertura",
      "type": "select",
      "options": [
        {
          "label": "Fade + escala",
          "value": "scale-fade"
        },
        {
          "label": "Subir",
          "value": "slide-up"
        },
        {
          "label": "Deslizar lateral",
          "value": "slide-side"
        },
        {
          "label": "Somente fade",
          "value": "fade"
        },
        {
          "label": "Sem animação",
          "value": "none"
        }
      ],
      "group": "Animação"
    },
    {
      "key": "animationSpeed",
      "label": "Velocidade (ms)",
      "type": "range",
      "min": 80,
      "max": 700,
      "step": 20,
      "group": "Animação"
    },
    {
      "key": "showHeader",
      "label": "Exibir cabeçalho próprio",
      "type": "toggle",
      "group": "Cabeçalho"
    },
    {
      "key": "title",
      "label": "Título do container",
      "type": "text",
      "group": "Cabeçalho"
    },
    {
      "key": "subtitle",
      "label": "Texto de apoio",
      "type": "textarea",
      "rows": 3,
      "group": "Cabeçalho"
    },
    {
      "key": "closeEnabled",
      "label": "Exibir botão fechar",
      "type": "toggle",
      "group": "Fechar"
    },
    {
      "key": "closeIcon",
      "label": "Ícone do botão fechar",
      "type": "icon",
      "group": "Fechar"
    },
    {
      "key": "closeText",
      "label": "Texto acessível / opcional",
      "type": "text",
      "group": "Fechar"
    },
    {
      "key": "closePosition",
      "label": "Posição do botão",
      "type": "select",
      "options": [
        {
          "label": "Topo direito",
          "value": "right"
        },
        {
          "label": "Topo esquerdo",
          "value": "left"
        }
      ],
      "group": "Fechar"
    },
    {
      "key": "closeSize",
      "label": "Tamanho do botão (px)",
      "type": "range",
      "min": 32,
      "max": 64,
      "step": 2,
      "group": "Fechar"
    },
    {
      "key": "closeBackground",
      "label": "Fundo do botão",
      "type": "color",
      "group": "Fechar"
    },
    {
      "key": "closeColor",
      "label": "Cor do botão / ícone",
      "type": "color",
      "group": "Fechar"
    },
    {
      "key": "closeOnBackdrop",
      "label": "Fechar ao clicar fora",
      "type": "toggle",
      "group": "Comportamento"
    },
    {
      "key": "closeOnEscape",
      "label": "Fechar com ESC",
      "type": "toggle",
      "group": "Comportamento"
    },
    {
      "key": "lockScroll",
      "label": "Travar rolagem da página ao abrir",
      "type": "toggle",
      "group": "Comportamento"
    },
    {
      "key": "openOnHash",
      "label": "Abrir quando a URL carregar com #ID",
      "type": "toggle",
      "group": "Comportamento"
    }
  ],
  "inspectorGuide": {
    "enabled": true,
    "kind": "href-container",
    "label": "Como usar",
    "description": "Mostra o HREF real desta instância e como organizar os itens internos.",
    "targetField": "panelId",
    "targetPrefix": "#",
    "childCountField": "itemCount",
    "columns": {
      "desktop": "columns",
      "tablet": "tabletColumns",
      "mobile": "mobileColumns"
    },
    "modes": {
      "desktop": "displayMode",
      "mobile": "mobileMode"
    }
  }
}
